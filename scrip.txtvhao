<div class="item">
  <div>
    <div class="title">Skeleton ESP</div>
    <div class="sub">Bone-line overlay</div>
  </div>

  <label class="switch">
    <input type="checkbox">
    <span class="slider"></span>
  </label>
</div>

<style>
.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22px;
  background: #111;
  color: white;
  font-family: Arial, sans-serif;
}

.title {
  font-size: 24px;
  font-weight: 600;
}

.sub {
  margin-top: 5px;
  color: #999;
  font-size: 16px;
}

/* ON/OFF */
.switch {
  position: relative;
  width: 98px;
  height: 58px;
}

.switch input {
  display: none;
}

.slider {
  position: absolute;
  inset: 0;
  background: #202020;
  border: 2px solid #444;
  border-radius: 40px;
  cursor: pointer;
  transition: .2s;
}

.slider::before {
  content: "";
  position: absolute;
  width: 48px;
  height: 48px;
  left: 3px;
  top: 3px;
  background: #ccc;
  border-radius: 50%;
  transition: .2s;
}

/* ON */
.switch input:checked + .slider {
  background: #f4f2e9;
}

.switch input:checked + .slider::before {
  transform: translateX(40px);
  background: #050505;
}
</style>
